# AvisFlow Configuration
# Copy this file to .env and change the values

# Secret key for JWT tokens - CHANGE THIS IN PRODUCTION
SECRET_KEY=change-me-in-production-use-a-long-random-string

# Base URL for QR codes (change to your IP if DNS is not ready)
# Examples: https://avisflow.online, http://192.168.1.100, http://YOUR_PUBLIC_IP
BASE_URL=https://avisflow.online
